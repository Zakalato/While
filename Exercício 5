package Lista1;

import java.util.Scanner;

public class Exercicio_5 {

    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        // Variáveis de comparação (Maior/Menor)
        double maior = 0;
        double menor = Double.MAX_VALUE; // Começa com o maior valor possível para o Java

        // Acumuladores para os tipos de consumidor
        double totalResidencial = 0;
        double totalComercial = 0;
        double totalIndustrial = 0;

        // Variáveis para a média geral
        double somaGeralConsumo = 0;
        int contadorConsumidores = 0;

        System.out.println("Deseja calcular o consumo de energia? S/N");
        String continua = s.next();

        while (continua.equalsIgnoreCase("S")) {
            
            System.out.println("Número do consumidor:");
            int numConsumidor = s.nextInt();

            System.out.println("Preço do kWh:");
            double precoKwh = s.nextDouble();

            System.out.println("Quantidade de kWh consumidos no mês:");
            double consumo = s.nextDouble();

            System.out.println("Tipo de consumo (R - Residencial, C - Comercial, I - Industrial):");
            String tipo = s.next();

            // a) Calcular o total a pagar para ESTE consumidor
            double totalPagar = consumo * precoKwh;
            System.out.printf("Consumidor %d - Total a pagar: R$ %.2f\n", numConsumidor, totalPagar);

            // b) e c) Verificar maior e menor consumo
            if (consumo > maior) {
                maior = consumo;
            }
            if (consumo < menor) {
                menor = consumo;
            }

            // d) Acumular o consumo por tipo
            if (tipo.equalsIgnoreCase("R")) {
                totalResidencial += consumo;
            } else if (tipo.equalsIgnoreCase("C")) {
                totalComercial += consumo;
            } else if (tipo.equalsIgnoreCase("I")) {
                totalIndustrial += consumo;
            }

            // Preparação para a média (e)
            somaGeralConsumo += consumo;
            contadorConsumidores++;

            System.out.println("\nDeseja inserir outro consumidor? S/N");
            continua = s.next();
        }

        // --- EXIBIÇÃO DOS RESULTADOS FINAIS ---
        if (contadorConsumidores > 0) {
            double mediaGeral = somaGeralConsumo / contadorConsumidores;

            System.out.println("\n======= RELATÓRIO FINAL =======");
            System.out.printf("Maior consumo verificado: %.2f kWh\n", maior);
            System.out.printf("Menor consumo verificado: %.2f kWh\n", menor);
            System.out.println("-------------------------------");
            System.out.printf("Total Residencial: %.2f kWh\n", totalResidencial);
            System.out.printf("Total Comercial:   %.2f kWh\n", totalComercial);
            System.out.printf("Total Industrial:  %.2f kWh\n", totalIndustrial);
            System.out.println("-------------------------------");
            System.out.printf("Média Geral de Consumo: %.2f kWh\n", mediaGeral);
            System.out.println("===============================");
        } else {
            System.out.println("Nenhum dado foi inserido.");
        }

        s.close();
    }
}
